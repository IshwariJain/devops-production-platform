# Terraform downloaded files
**/.terraform/

# Terraform state files
*.tfstate
*.tfstate.*

# Terraform crash logs
crash.log
crash.*.log

# Terraform variable files (may contain secrets)
*.tfvars
*.tfvars.json

# Local environment secrets
.env
.env.*

# Python local files
__pycache__/
*.pyc
.pytest_cache/
venv/
.venv/
*.tfplan
